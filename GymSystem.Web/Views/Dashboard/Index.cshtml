@model GymSystem.Web.ViewModels.Dashboard.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var today = DateTime.Today;
}

@section Styles {
    <style>
        .dashboard-stat-card {
            display: flex;
            flex-direction: column;
            background-color: var(--surface-lowest);
            border: none;
            border-radius: 1rem;
            padding: 1.5rem;
            height: 100%;
            min-height: 196px;
            box-shadow: 0px 20px 40px rgba(28, 27, 27, 0.03);
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
            text-decoration: none;
            color: inherit;
        }

        .dashboard-stat-card:hover {
            transform: translateY(-4px);
            box-shadow: 0px 24px 48px rgba(28, 27, 27, 0.07);
            color: inherit;
        }

        .dashboard-stat-card--hero {
            min-height: 220px;
            background: linear-gradient(145deg, var(--surface-lowest) 55%, rgba(0, 74, 232, 0.06) 100%);
        }

        .dashboard-stat-card--hero::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: var(--primary-gradient);
            border-radius: 1rem 1rem 0 0;
        }

        .stat-card-watermark {
            position: absolute;
            right: -0.5rem;
            bottom: -0.75rem;
            font-size: 6.5rem;
            line-height: 1;
            opacity: 0.07;
            pointer-events: none;
        }

        .stat-label {
            font-family: var(--font-body);
            font-weight: 700;
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.75px;
            color: var(--text-main);
            opacity: 0.55;
        }

        .stat-icon-wrap {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.15rem;
            flex-shrink: 0;
        }

        .stat-kpi {
            font-family: var(--font-display);
            font-weight: 800;
            letter-spacing: -1.5px;
            color: var(--text-main);
            margin: 0.5rem 0 0.25rem;
            line-height: 1.1;
        }

        .stat-kpi--hero {
            font-size: clamp(2.5rem, 5vw, 3.5rem);
        }

        .stat-kpi--md {
            font-size: clamp(2rem, 4vw, 2.75rem);
        }

        .stat-meta {
            font-family: var(--font-body);
            font-size: 0.875rem;
            color: var(--text-main);
            opacity: 0.55;
            margin-bottom: 0;
        }

        .stat-progress-track {
            height: 6px;
            border-radius: 3px;
            background-color: var(--surface-low);
            overflow: hidden;
            margin-top: 1rem;
        }

        .stat-progress-fill {
            height: 100%;
            border-radius: 3px;
            transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .stat-cta {
            margin-top: auto;
            padding-top: 1.25rem;
            font-family: var(--font-display);
            font-weight: 600;
            font-size: 0.875rem;
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            transition: gap 0.2s ease;
        }

        .dashboard-stat-card:hover .stat-cta {
            gap: 0.55rem;
        }

        .stat-badge {
            font-family: var(--font-display);
            font-size: 0.7rem;
            font-weight: 700;
            letter-spacing: 0.25px;
            padding: 0.35rem 0.75rem;
            border-radius: 50px;
        }

        .member-list-item {
            transition: all 0.2s ease;
            border-radius: 12px;
            margin-bottom: 8px;
            background-color: transparent;
        }

            .member-list-item:hover {
                background-color: var(--surface-low) !important;
            }

        .avatar-circle {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: var(--font-display);
            font-weight: 700;
            color: #ffffff;
            font-size: 1rem;
            box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.05);
        }

        .custom-scroll {
            max-height: 450px;
            overflow-y: auto;
            padding-right: 4px;
        }

            .custom-scroll::-webkit-scrollbar {
                width: 6px;
            }

            .custom-scroll::-webkit-scrollbar-track {
                background: transparent;
            }

            .custom-scroll::-webkit-scrollbar-thumb {
                background: var(--surface-high);
                border-radius: 3px;
            }
    </style>
}

<div class="container-fluid py-4">
    @* Header *@
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-5">
        <div>
            <h1 class="display-6 fw-extrabold text-main mb-1" style="font-family: var(--font-display); letter-spacing: -1.5px;">
                Dashboard
            </h1>
            <p class="text-muted mb-0">
                <i class="bi bi-calendar-date me-2"></i>@today.ToString("dddd, MMMM d, yyyy")
            </p>
        </div>
        <div>
            <a asp-controller="Attendance" asp-action="CheckIn" class="btn btn-primary rounded-pill text-white px-4 py-2.5 d-flex align-items-center gap-2" style="background: var(--primary-gradient); border: none; font-weight: 600; font-family: var(--font-display);">
                <i class="bi bi-plus-lg"></i> Quick Check-In
            </a>
        </div>
    </div>

    @* Alert Messages *@
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 rounded-3 bg-success bg-opacity-10 text-success p-3 mb-4 d-flex align-items-center gap-2 alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill"></i>
            <div>@TempData["Success"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @{
        var subscriptionPct = Model.TotalMembers > 0
            ? Math.Min(100, (double)Model.ActiveSubscriptions / Model.TotalMembers * 100)
            : 0;
        var attendancePct = Model.TotalMembers > 0
            ? Math.Min(100, (double)Model.TodayAttendance / Model.TotalMembers * 100)
            : 0;
        var classesFill = Model.TotalClasses > 0 ? 100.0 : 0.0;
    }

    @* KPI Stats — Power column + balanced row *@
    <div class="row g-4 mb-5">
        @* Total Members — hero power card *@
        <div class="col-xl-5 col-lg-6">
            <a asp-controller="Members" asp-action="Index" class="dashboard-stat-card dashboard-stat-card--hero">
                <i class="bi bi-people-fill stat-card-watermark text-primary"></i>
                <div class="position-relative z-1 d-flex flex-column h-100">
                    <div class="d-flex justify-content-between align-items-start">
                        <span class="stat-label">Total Members</span>
                        <span class="stat-badge bg-primary bg-opacity-10 text-primary">
                            <i class="bi bi-arrow-up-right me-1"></i>Directory
                        </span>
                    </div>
                    <h2 class="stat-kpi stat-kpi--hero text-primary">@Model.TotalMembers.ToString("N0")</h2>
                    <p class="stat-meta">@Model.MemberGrowthIndicator Members registered in your gym</p>
                    @* <div class="stat-progress-track">
                        <div class="stat-progress-fill" style="width: 100%; background: var(--primary-gradient);"></div>
                    </div> *@
                    <span class="stat-cta text-primary">Explore directory <i class="bi bi-arrow-right"></i></span>
                </div>
            </a>
        </div>

        <div class="col-xl-7 col-lg-6">
            <div class="row g-4 h-100">
                @* Active Subscriptions *@
                <div class="col-md-4 col-sm-6">
                    <a asp-controller="Subscriptions" asp-action="Index" class="dashboard-stat-card">
                        <i class="bi bi-card-checklist stat-card-watermark text-success"></i>
                        <div class="position-relative z-1 d-flex flex-column h-100">
                            <div class="d-flex justify-content-between align-items-start">
                                <span class="stat-label">Active Subscriptions</span>
                                <div class="stat-icon-wrap bg-success bg-opacity-10 text-success">
                                    <i class="bi bi-check-circle-fill"></i>
                                </div>
                            </div>
                            <h3 class="stat-kpi stat-kpi--md text-success">@Model.ActiveSubscriptions.ToString("N0")</h3>
                            <p class="stat-meta">@Model.SubscriptionRate of members</p>
                            @* <div class="stat-progress-track">
                                <div class="stat-progress-fill bg-success" style="width: @(subscriptionPct.ToString("F0"))%;"></div>
                            </div> *@
                            <span class="stat-cta text-success">Manage plans <i class="bi bi-arrow-right"></i></span>
                        </div>
                    </a>
                </div>

                @* Today's Check-ins *@
                <div class="col-md-4 col-sm-6">
                    <a asp-controller="Attendance" asp-action="Index" class="dashboard-stat-card">
                        <i class="bi bi-box-arrow-in-right stat-card-watermark text-primary"></i>
                        <div class="position-relative z-1 d-flex flex-column h-100">
                            <div class="d-flex justify-content-between align-items-start">
                                <span class="stat-label">Today's Check-ins</span>
                                <div class="stat-icon-wrap bg-primary bg-opacity-10 text-primary">
                                    <i class="bi bi-clipboard-check-fill"></i>
                                </div>
                            </div>
                            <h3 class="stat-kpi stat-kpi--md text-primary">@Model.TodayAttendance.ToString("N0")</h3>
                            <p class="stat-meta">@Model.AttendanceRate attendee rate</p>
                            @* <div class="stat-progress-track">
                                <div class="stat-progress-fill" style="width: @(attendancePct.ToString("F0"))%; background: var(--primary-gradient);"></div>
                            </div> *@
                            <span class="stat-cta text-primary">View attendance <i class="bi bi-arrow-right"></i></span>
                        </div>
                    </a>
                </div>

                @* Total Classes *@
                <div class="col-md-4 col-sm-12">
                    <a asp-controller="Classes" asp-action="Index" class="dashboard-stat-card">
                        <i class="bi bi-calendar3 stat-card-watermark" style="color: #9e3d00;"></i>
                        <div class="position-relative z-1 d-flex flex-column h-100">
                            <div class="d-flex justify-content-between align-items-start">
                                <span class="stat-label">Total Classes</span>
                                <div class="stat-icon-wrap" style="background-color: rgba(158, 61, 0, 0.12); color: #9e3d00;">
                                    <i class="bi bi-lightning-charge-fill"></i>
                                </div>
                            </div>
                            <h3 class="stat-kpi stat-kpi--md" style="color: #9e3d00;">@Model.TotalClasses.ToString("N0")</h3>
                            <p class="stat-meta">Scheduled &amp; active</p>
                            @* <div class="stat-progress-track">
                                <div class="stat-progress-fill" style="width: @(classesFill.ToString("F0"))%; background-color: #9e3d00;"></div>
                            </div> *@
                            <span class="stat-cta" style="color: #9e3d00;">Manage classes <i class="bi bi-arrow-right"></i></span>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>

    @* Bento Grid Lists Section *@
    <div class="row g-4">
        @* Expiring Subscriptions *@
        <div class="col-lg-6">
            <div class="card bg-surface-lowest border-0 rounded-4 p-4 h-100" style="box-shadow: 0px 20px 40px rgba(28, 27, 27, 0.03);">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="h6 mb-0 fw-bold font-display text-main">
                        <i class="bi bi-exclamation-triangle text-warning me-2"></i>Expiring within 7 days
                    </h5>
                    @if (Model.ExpiringSubscriptions.Any())
                    {
                        <span class="badge bg-warning bg-opacity-10 text-warning px-3 py-2 rounded-pill fw-semibold">
                            @Model.ExpiringSubscriptions.Count() @(Model.ExpiringSubscriptions.Count() == 1 ? "member" : "members")
                        </span>
                    }
                </div>
                <div class="p-0">
                    @if (!Model.ExpiringSubscriptions.Any())
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-check-circle-fill text-success mb-3" style="font-size: 3rem; display: block;"></i>
                            <p class="text-muted mb-0">All subscriptions are up to date! 🎉</p>
                        </div>
                    }
                    else
                    {
                        <div class="custom-scroll">
                            @foreach (var sub in Model.ExpiringSubscriptions)
                            {
                                <div class="member-list-item py-3 px-3">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div class="d-flex align-items-center">
                                            <div class="me-3">
                                                <div class="avatar-circle bg-@sub.UrgencyClass">
                                                    @sub.MemberName?.Substring(0, 1).ToUpper()
                                                </div>
                                            </div>
                                            <div>
                                                <a asp-controller="Members" asp-action="Details"
                                                   asp-route-id="@sub.MemberId"
                                                   class="fw-bold text-decoration-none text-main font-display">
                                                    @sub.MemberName
                                                </a>
                                                <div class="text-muted small">@sub.PlanName</div>
                                                <small class="text-muted" style="font-size: 0.75rem;">Expires: @sub.EndDateFormatted</small>
                                            </div>
                                        </div>
                                        <div class="text-end">
                                            <span class="badge bg-@sub.UrgencyClass bg-opacity-10 text-@sub.UrgencyClass rounded-pill px-3 py-2 fw-semibold">
                                                <i class="bi @sub.UrgencyIcon me-1"></i>
                                                @sub.UrgencyText
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        @* Today's Activity *@
        <div class="col-lg-6">
            <div class="card bg-surface-lowest border-0 rounded-4 p-4 h-100" style="box-shadow: 0px 20px 40px rgba(28, 27, 27, 0.03);">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="h6 mb-0 fw-bold font-display text-main">
                        <i class="bi bi-clipboard-check text-primary me-2"></i>Today's Activity
                    </h5>
                    <div>
                        <a asp-controller="Attendance" asp-action="CheckIn"
                           class="btn btn-logout d-flex align-items-center gap-2">
                            <i class="bi bi-plus-lg"></i> Check In
                        </a>
                    </div>
                </div>
                <div class="p-0">
                    @if (!Model.TodayCheckIns.Any())
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-clipboard-x text-muted mb-3" style="font-size: 3rem; display: block;"></i>
                            <p class="text-muted mb-3">No activity yet today</p>
                            <a asp-controller="Attendance" asp-action="CheckIn"
                               class="btn btn-primary rounded-pill px-4 text-white"
                               style="background: var(--primary-gradient); border: none; font-weight: 600;">
                                <i class="bi bi-plus-lg me-1"></i> Record First Check-In
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="custom-scroll">
                            @foreach (var record in Model.TodayCheckIns)
                            {
                                <div class="member-list-item py-3 px-3">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div class="d-flex align-items-center">
                                            <div class="me-3">
                                                <span class="badge @record.StatusBadgeClass p-2 rounded-3">
                                                    <i class="bi @record.StatusIcon"></i>
                                                </span>
                                            </div>
                                            <div>
                                                <span class="fw-bold text-main">@record.MemberName</span>
                                                <div class="text-muted small">
                                                    <i class="bi bi-clock me-1"></i>
                                                    @record.CheckInTimeFormatted
                                                    @if (record.CheckOutTime.HasValue)
                                                    {
                                                        <span> &rarr; @record.CheckOutTimeFormatted</span>
                                                        <br />
                                                        <span class="text-info fw-semibold">
                                                            <i class="bi bi-stopwatch me-1"></i>
                                                            @record.Duration
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <br />
                                                        <span class="text-success small fw-semibold">
                                                            <i class="bi bi-arrow-repeat me-1 spinner-border spinner-border-sm border-0" style="animation-duration: 1.5s;"></i>
                                                            @record.Duration
                                                        </span>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                        @if (record.IsOpen)
                                        {
                                            <form asp-controller="Attendance" asp-action="CheckOut"
                                                  method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@record.AttendanceId" />
                                                <button type="submit"
                                                        class="btn btn-sm btn-logout">
                                                    <i class="bi bi-box-arrow-right me-1"></i>
                                                    Check Out
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2 fw-semibold">
                                                <i class="bi bi-check2 me-1"></i>Done
                                            </span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Auto-refresh dashboard every 5 minutes
        // setInterval(function() {
        //     location.reload();
        // }, 300000);

        // Confirm before checkout
        $(document).ready(function() {
            $('form[asp-action="CheckOut"]').on('submit', function(e) {
                var memberName = $(this).closest('.member-list-item').find('.fw-bold').text();
                if (!confirm('Check out ' + memberName + '?')) {
                    e.preventDefault();
                }
            });
        });
    </script>
}