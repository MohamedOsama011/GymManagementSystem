@model IEnumerable<GymSystem.Web.ViewModels.Attendance.AttendanceViewModel>

@{
    ViewData["Title"] = "Today's Attendance";
    var stats = ViewBag.Stats as GymSystem.BLL.Services.Interfaces.AttendanceStatsDto;
    var todayLabel = DateTime.Now.ToString("dddd, MMMM d, yyyy");
    var isFiltered = ViewBag.FromDate != null || ViewBag.ToDate != null || ViewBag.MemberId != null;
    var recordCount = Model.Count();
}

@section Styles {
    <style>
        .attendance-table-card {
            box-shadow: 0px 20px 40px rgba(28, 27, 27, 0.03);
        }

        .table {
            border-collapse: separate;
            border-spacing: 0 4px;
        }

        .table th {
            border: none !important;
            font-family: var(--font-display);
            font-weight: 700;
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 0.75px;
            color: var(--text-main);
            opacity: 0.6;
            padding: 16px 24px !important;
        }

        .table td {
            border: none !important;
            padding: 18px 24px !important;
            font-family: var(--font-body);
            color: var(--text-main);
        }

        .table tbody tr {
            border-radius: 12px;
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .table tbody tr:hover {
            background-color: var(--surface-low) !important;
        }

        .table tbody tr.row-active {
            background-color: rgba(0, 74, 232, 0.04);
        }

        .member-avatar {
            width: 44px;
            height: 44px;
            border-radius: 0.75rem;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: var(--font-display);
            font-weight: 700;
            font-size: 1rem;
            color: var(--primary);
            background-color: rgba(0, 74, 232, 0.1);
            flex-shrink: 0;
        }

        .filter-label {
            font-family: var(--font-display);
            font-weight: 700;
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--text-main);
            opacity: 0.5;
            margin-bottom: 8px;
        }

        .filter-input {
            background-color: var(--surface-low) !important;
            border: none !important;
            border-radius: 12px !important;
            padding: 12px 18px !important;
            font-family: var(--font-body);
            font-weight: 500;
            color: var(--text-main) !important;
            transition: all 0.2s ease;
        }

        .filter-input:focus {
            box-shadow: 0px 0px 0px 4px rgba(0, 74, 232, 0.12) !important;
            background-color: var(--surface-lowest) !important;
        }

        .stat-mini-card {
            background-color: var(--surface-lowest);
            border: none;
            border-radius: 1rem;
            box-shadow: 0px 20px 40px rgba(28, 27, 27, 0.03);
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
            height: 100%;
        }

        .stat-mini-card:hover {
            transform: translateY(-4px);
            box-shadow: 0px 24px 48px rgba(28, 27, 27, 0.07);
        }

        .stat-icon-wrap {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.15rem;
        }

        .btn-action {
            border: none;
            transition: all 0.2s ease;
        }

        .btn-action:hover {
            transform: scale(1.02);
        }

        .empty-state-icon {
            font-size: 4rem;
            color: var(--surface-high);
            display: block;
            margin-bottom: 1rem;
        }

        .records-count {
            font-family: var(--font-display);
            font-weight: 700;
            font-size: 0.75rem;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            color: var(--text-main);
            opacity: 0.5;
        }
    </style>
}

<div class="container-fluid py-4">

    @* Header *@
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-5">
        <div>
            <h1 class="display-6 fw-extrabold text-main mb-1" style="font-family: var(--font-display); letter-spacing: -1.5px;">
                @(isFiltered ? "Attendance Records" : "Today's Attendance")
            </h1>
            <p class="text-muted mb-0">
                <i class="bi bi-calendar-date me-2"></i>@todayLabel
                @if (isFiltered)
                {
                    <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill ms-2 px-3 py-2 fw-semibold">Filtered</span>
                }
            </p>
        </div>
        <div>
            <a asp-action="CheckIn" class="btn btn-primary rounded-pill text-white px-4 py-2.5 d-flex align-items-center gap-2 btn-action" style="background: var(--primary-gradient); border: none; font-weight: 600; font-family: var(--font-display);">
                <i class="bi bi-box-arrow-in-right"></i> New Check-In
            </a>
        </div>
    </div>

    @* Alerts *@
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 rounded-3 bg-success bg-opacity-10 text-success p-3 mb-4 d-flex align-items-center gap-2 alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill"></i>
            <div>@TempData["Success"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger border-0 rounded-3 bg-danger bg-opacity-10 text-danger p-3 mb-4 d-flex align-items-center gap-2 alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle-fill"></i>
            <div>@TempData["Error"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @* KPI Stats *@
    @if (stats != null)
    {
        <div class="row g-4 mb-5">
            <div class="col-xl-3 col-md-6">
                <div class="card stat-mini-card p-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-muted fw-bold text-uppercase small" style="font-family: var(--font-body); letter-spacing: 0.5px;">Check-Ins Today</span>
                            <h3 class="display-6 fw-extrabold text-main mb-0 mt-2" style="font-family: var(--font-display); letter-spacing: -1px;">@stats.TotalCheckIns</h3>
                        </div>
                        <div class="stat-icon-wrap bg-primary bg-opacity-10 text-primary">
                            <i class="bi bi-calendar-check-fill"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6">
                <div class="card stat-mini-card p-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-muted fw-bold text-uppercase small" style="font-family: var(--font-body); letter-spacing: 0.5px;">Active Now</span>
                            <h3 class="display-6 fw-extrabold text-success mb-0 mt-2" style="font-family: var(--font-display); letter-spacing: -1px;">@stats.ActiveMembers</h3>
                        </div>
                        <div class="stat-icon-wrap bg-success bg-opacity-10 text-success">
                            <i class="bi bi-people-fill"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6">
                <div class="card stat-mini-card p-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-muted fw-bold text-uppercase small" style="font-family: var(--font-body); letter-spacing: 0.5px;">Avg Duration</span>
                            <h3 class="display-6 fw-extrabold text-main mb-0 mt-2" style="font-family: var(--font-display); letter-spacing: -1px;">
                                @(stats.AverageDurationMinutes > 0 ? $"{(int)stats.AverageDurationMinutes}m" : "N/A")
                            </h3>
                        </div>
                        <div class="stat-icon-wrap bg-info bg-opacity-10 text-info">
                            <i class="bi bi-clock-fill"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6">
                <div class="card stat-mini-card p-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-muted fw-bold text-uppercase small" style="font-family: var(--font-body); letter-spacing: 0.5px;">Peak Hour</span>
                            <h3 class="fw-bold text-main mb-0 mt-2" style="font-family: var(--font-display); font-size: 1.35rem; letter-spacing: -0.5px;">
                                @(stats.PeakHour > 0 ? $"{stats.PeakHour}:00 – {stats.PeakHour + 1}:00" : "N/A")
                            </h3>
                        </div>
                        <div class="stat-icon-wrap" style="background-color: rgba(230, 126, 34, 0.12); color: #e67e22;">
                            <i class="bi bi-graph-up-arrow"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    @* Filter Bar *@
    <div class="card bg-surface-lowest border-0 rounded-4 p-4 mb-4" style="box-shadow: 0px 20px 40px rgba(28, 27, 27, 0.03);">
        <form asp-action="Filter" method="get" class="row g-4 align-items-end">
            <div class="col-md-3">
                <div class="filter-label">From Date</div>
                <input type="date" name="fromDate" class="form-control filter-input" value="@ViewBag.FromDate" />
            </div>
            <div class="col-md-3">
                <div class="filter-label">To Date</div>
                <input type="date" name="toDate" class="form-control filter-input" value="@ViewBag.ToDate" />
            </div>
            <div class="col-md-3">
                <div class="filter-label">Member ID</div>
                <input type="number" name="memberId" class="form-control filter-input" placeholder="e.g. 12" value="@ViewBag.MemberId" />
            </div>
            <div class="col-md-3 d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary rounded-pill text-white px-4 py-2.5 btn-action flex-grow-1" style="background: var(--primary-gradient); font-family: var(--font-display); font-weight: 600;">
                    <i class="bi bi-funnel-fill me-1"></i> Filter
                </button>
                <a asp-action="Index" class="btn rounded-pill px-4 py-2.5 btn-action fw-semibold flex-grow-1" style="background-color: var(--surface-low); color: var(--text-main); font-family: var(--font-display);">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Reset
                </a>
            </div>
        </form>
    </div>

    @* Records Table *@
    <div class="card bg-surface-lowest border-0 rounded-4 p-4 attendance-table-card">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="h5 fw-bold text-main mb-0" style="font-family: var(--font-display); letter-spacing: -0.5px;">
                <i class="bi bi-list-check me-2 text-primary"></i>Attendance Records
            </h2>
            <span class="records-count">@recordCount total</span>
        </div>

        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle border-0 mb-0" id="attendanceTable">
                    <thead>
                        <tr>
                            <th>Member</th>
                            <th>Date</th>
                            <th>Check-In</th>
                            <th>Check-Out</th>
                            <th>Duration</th>
                            <th>Status</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var initial = string.IsNullOrWhiteSpace(item.MemberName)
                                ? "?"
                                : item.MemberName.Trim().Substring(0, 1).ToUpper();

                            <tr class="@(item.IsOpen ? "row-active" : "")">
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="member-avatar">@initial</div>
                                        <div class="overflow-hidden">
                                            <div class="fw-bold text-truncate" style="font-size: 0.95rem;">@item.MemberName</div>
                                            <div class="text-muted text-truncate" style="font-size: 0.85rem;">ID #@item.MemberId</div>
                                        </div>
                                    </div>
                                </td>
                                <td>@item.FormattedDate</td>
                                <td>
                                    <span class="text-success fw-semibold">
                                        <i class="bi bi-box-arrow-in-right me-1"></i>@item.FormattedCheckIn
                                    </span>
                                </td>
                                <td>
                                    @if (item.CheckOutTime.HasValue)
                                    {
                                        <span class="text-danger fw-semibold">
                                            <i class="bi bi-box-arrow-right me-1"></i>@item.FormattedCheckOut
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge @(item.IsOpen ? "bg-primary bg-opacity-10 text-primary" : "bg-secondary bg-opacity-10 text-secondary") rounded-pill px-3 py-2 fw-semibold">
                                        @item.Duration
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @item.StatusBadgeClass rounded-pill px-3 py-2 fw-semibold">
                                        <i class="bi @item.StatusIcon me-1"></i>@item.StatusText
                                    </span>
                                </td>
                                <td class="text-center">
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-outline-secondary rounded-circle border-0"
                                                type="button"
                                                data-bs-toggle="dropdown"
                                                aria-expanded="false"
                                                style="width: 32px; height: 32px; padding: 0;">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3" style="min-width: 180px;">
                                            <li>
                                                <a asp-action="MemberHistory" asp-route-memberId="@item.MemberId" class="dropdown-item py-2">
                                                    <i class="bi bi-clock-history me-2"></i> View History
                                                </a>
                                            </li>
                                            @if (item.IsOpen)
                                            {
                                                <li><hr class="dropdown-divider" /></li>
                                                <li>
                                                    <button type="button"
                                                            class="dropdown-item py-2 text-warning checkout-btn"
                                                            data-id="@item.Id"
                                                            data-member="@item.MemberName">
                                                        <i class="bi bi-box-arrow-right me-2"></i> Check Out
                                                    </button>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-clipboard2-x empty-state-icon"></i>
                <h4 class="fw-bold text-main mb-2" style="font-family: var(--font-display);">No attendance records found</h4>
                <p class="text-muted mb-4">@(isFiltered ? "Try adjusting your filter criteria." : "No one has checked in today yet.")</p>
                <a asp-action="CheckIn" class="btn btn-primary rounded-pill text-white px-4 py-2 btn-action" style="background: var(--primary-gradient); border: none; font-weight: 600; font-family: var(--font-display);">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Record Check-In
                </a>
            </div>
        }
    </div>
</div>

@* Check-Out Modal *@
<div class="modal fade" id="checkoutModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow-lg">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" style="font-family: var(--font-display);">
                    <i class="bi bi-box-arrow-right text-warning me-2"></i>Confirm Check-Out
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-2">
                <p class="mb-1">Check out <strong id="memberName"></strong>?</p>
                <p class="text-muted small mb-0">The current time will be recorded as check-out time.</p>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn rounded-pill px-4 fw-semibold" data-bs-dismiss="modal" style="background-color: var(--surface-low); color: var(--text-main); font-family: var(--font-display);">Cancel</button>
                <form id="checkoutForm" method="post" asp-action="CheckOut" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="attendanceId" />
                    <button type="submit" class="btn btn-primary rounded-pill text-white px-4 fw-semibold btn-action" style="background: var(--primary-gradient); border: none; font-family: var(--font-display);">
                        <i class="bi bi-check-lg me-1"></i> Confirm
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.checkout-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                document.getElementById('attendanceId').value = btn.dataset.id;
                document.getElementById('memberName').textContent = btn.dataset.member;
                new bootstrap.Modal(document.getElementById('checkoutModal')).show();
            });
        });
    </script>
}
