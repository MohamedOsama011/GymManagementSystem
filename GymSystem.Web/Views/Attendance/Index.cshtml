@* 📁 Views/Attendance/Index.cshtml *@
@model IEnumerable<GymSystem.Web.ViewModels.Attendance.AttendanceViewModel>

@{
    ViewData["Title"] = "Today's Attendance";
    var stats = ViewBag.Stats as GymSystem.BLL.Services.Interfaces.AttendanceStatsDto;
}

<div class="container-fluid">
    @* Header with Stats Cards *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>
            <i class="fas fa-clipboard-check me-2"></i>Today's Attendance
            <small class="text-muted fs-6">@DateTime.Now.ToString("dddd, MMM dd, yyyy")</small>
        </h2>
        <div>
            <a asp-action="CheckIn" class="btn btn-primary">
                <i class="fas fa-sign-in-alt me-2"></i>New Check-In
            </a>
        </div>
    </div>

    @* Alert Messages *@
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @* Statistics Cards *@
    @if (stats != null)
    {
        <div class="row mb-4">
            <div class="col-xl-3 col-md-6 mb-3">
                <div class="card border-left-primary shadow h-100">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                    Total Check-Ins Today
                                </div>
                                <div class="h5 mb-0 font-weight-bold text-gray-800">
                                    @stats.TotalCheckIns
                                </div>
                            </div>
                            <div class="col-auto">
                                <i class="fas fa-calendar-check fa-2x text-gray-300"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6 mb-3">
                <div class="card border-left-success shadow h-100">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                    Active Now
                                </div>
                                <div class="h5 mb-0 font-weight-bold text-gray-800">
                                    @stats.ActiveMembers
                                </div>
                            </div>
                            <div class="col-auto">
                                <i class="fas fa-users fa-2x text-gray-300"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6 mb-3">
                <div class="card border-left-info shadow h-100">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                                    Avg Duration
                                </div>
                                <div class="h5 mb-0 font-weight-bold text-gray-800">
                                    @(stats.AverageDurationMinutes > 0
                                                                    ? $"{(int)stats.AverageDurationMinutes} min"
                                                                    : "N/A")
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-auto">
                                                                        <i class="fas fa-clock fa-2x text-gray-300"></i>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>

            <div class="col-xl-3 col-md-6 mb-3">
                <div class="card border-left-warning shadow h-100">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                                    Peak Hour
                                </div>
                                <div class="h5 mb-0 font-weight-bold text-gray-800">
                                    @(stats.PeakHour > 0
                                                                    ? $"{stats.PeakHour}:00 - {stats.PeakHour + 1}:00"
                                                                    : "N/A")
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-chart-line fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
        }

    @* Filter Section *@
    <div class="card shadow mb-4">
        <div class="card-header bg-light">
            <h6 class="m-0 font-weight-bold">
                <i class="fas fa-filter me-2"></i>Filter Records
            </h6>
        </div>
        <div class="card-body">
            <form asp-action="Filter" method="get" class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">From Date</label>
                    <input type="date" name="fromDate" class="form-control"
                           value="@ViewBag.FromDate" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">To Date</label>
                    <input type="date" name="toDate" class="form-control"
                           value="@ViewBag.ToDate" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Member</label>
                    <input type="number" name="memberId" class="form-control"
                           placeholder="Member ID" value="@ViewBag.MemberId" />
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary me-2">
                        <i class="fas fa-search me-1"></i> Filter
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-redo me-1"></i> Reset
                    </a>
                </div>
            </form>
        </div>
    </div>

    @* Attendance Table *@
    <div class="card shadow">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold">
                <i class="fas fa-list me-2"></i>Attendance Records
            </h6>
            <span class="badge bg-light text-dark">
                Total: @Model.Count()
            </span>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover" id="attendanceTable">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Member</th>
                            <th>Date</th>
                            <th>Check-In</th>
                            <th>Check-Out</th>
                            <th>Duration</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr class="@item.RowClass">
                                    <td>
                                        <span class="badge bg-secondary">#@item.Id</span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-sm me-2">
                                                <div class="avatar-title bg-primary rounded-circle">
                                                    @item.MemberName?.Substring(0, 1).ToUpper()
                                                </div>
                                            </div>
                                            <div>
                                                <strong>@item.MemberName</strong>
                                                <br />
                                                <small class="text-muted">ID: @item.MemberId</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span>@item.FormattedDate</span>
                                    </td>
                                    <td>
                                        <span class="text-success">
                                            <i class="fas fa-sign-in-alt me-1"></i>
                                            @item.FormattedCheckIn
                                        </span>
                                    </td>
                                    <td>
                                        @if (item.CheckOutTime.HasValue)
                                        {
                                            <span class="text-danger">
                                                <i class="fas fa-sign-out-alt me-1"></i>
                                                @item.FormattedCheckOut
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-info">@item.Duration</span>
                                    </td>
                                    <td>
                                        <span class="badge @item.StatusBadgeClass">
                                            <i class="fas @item.StatusIcon me-1"></i>
                                            @item.StatusText
                                        </span>
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="MemberHistory"
                                               asp-route-memberId="@item.MemberId"
                                               class="btn btn-outline-info"
                                               title="View History">
                                                <i class="fas fa-history"></i>
                                            </a>
                                            @if (item.IsOpen)
                                            {
                                                <button onclick="checkOut(@item.Id, '@item.MemberName')"
                                                        class="btn btn-outline-warning"
                                                        title="Check-Out">
                                                    <i class="fas fa-sign-out-alt"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5">
                                    <div class="text-muted">
                                        <i class="fas fa-clipboard fa-4x mb-3"></i>
                                        <h5>No attendance records found</h5>
                                        <p>No one has checked in today yet.</p>
                                        <a asp-action="CheckIn" class="btn btn-primary mt-2">
                                            <i class="fas fa-sign-in-alt me-2"></i>Record Check-In
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @* Quick Check-Out Modal *@
    <div class="modal fade" id="checkoutModal" tabindex="-1">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header bg-warning">
                    <h5 class="modal-title text-white">
                        <i class="fas fa-sign-out-alt me-2"></i>Confirm Check-Out
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>Check out <strong id="memberName"></strong>?</p>
                    <small class="text-muted">This will record the current time as check-out time.</small>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <form id="checkoutForm" method="post" asp-action="CheckOut">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" id="attendanceId" />
                        <button type="submit" class="btn btn-warning">
                            <i class="fas fa-check me-1"></i> Confirm Check-Out
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .border-left-primary { border-left: 4px solid #4e73df; }
        .border-left-success { border-left: 4px solid #1cc88a; }
        .border-left-info { border-left: 4px solid #36b9cc; }
        .border-left-warning { border-left: 4px solid #f6c23e; }

        .avatar-sm {
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .avatar-title {
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: bold;
            font-size: 1.2rem;
        }

        .table-hover tbody tr:hover {
            background-color: #f8f9fc;
        }
    </style>
}

@section Scripts {
    <script>
        function checkOut(id, memberName) {
            document.getElementById('attendanceId').value = id;
            document.getElementById('memberName').textContent = memberName;
            var modal = new bootstrap.Modal(document.getElementById('checkoutModal'));
            modal.show();
        }

        // Auto-refresh every 60 seconds (optional)
        // setInterval(function() {
        //     location.reload();
        // }, 60000);
    </script>
}