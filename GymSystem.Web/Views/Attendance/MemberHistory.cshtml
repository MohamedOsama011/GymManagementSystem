@model IEnumerable<GymSystem.Web.ViewModels.Attendance.AttendanceViewModel>

@{
    ViewData["Title"] = "Member Attendance History";
    var memberId = ViewData["MemberId"] as int?;
    var memberName = ViewData["MemberName"] as string ?? "Member";
    var stats = ViewBag.Stats as GymSystem.BLL.Services.Interfaces.AttendanceStatsDto;
    var memberInitial = string.IsNullOrWhiteSpace(memberName) ? "?" : memberName.Trim().Substring(0, 1).ToUpper();
    var recordCount = Model.Count();
}

@section Styles {
    <style>
        .history-table-card {
            box-shadow: 0px 20px 40px rgba(28, 27, 27, 0.03);
        }

        .table {
            border-collapse: separate;
            border-spacing: 0 4px;
        }

        .table th {
            border: none !important;
            font-family: var(--font-display);
            font-weight: 700;
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 0.75px;
            color: var(--text-main);
            opacity: 0.6;
            padding: 16px 24px !important;
        }

        .table td {
            border: none !important;
            padding: 18px 24px !important;
            font-family: var(--font-body);
            color: var(--text-main);
        }

        .table tbody tr {
            border-radius: 12px;
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .table tbody tr:hover {
            background-color: var(--surface-low) !important;
        }

        .table tbody tr.row-active {
            background-color: rgba(0, 74, 232, 0.04);
        }

        .stat-mini-card {
            background-color: var(--surface-lowest);
            border: none;
            border-radius: 1rem;
            box-shadow: 0px 20px 40px rgba(28, 27, 27, 0.03);
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
            height: 100%;
        }

        .stat-mini-card:hover {
            transform: translateY(-4px);
            box-shadow: 0px 24px 48px rgba(28, 27, 27, 0.07);
        }

        .stat-icon-wrap {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.15rem;
            flex-shrink: 0;
        }

        .stat-kpi {
            font-family: var(--font-display);
            font-weight: 800;
            font-size: 1.75rem;
            letter-spacing: -1px;
            line-height: 1.1;
            margin: 0.35rem 0 0;
        }

        .member-avatar {
            width: 52px;
            height: 52px;
            border-radius: 0.75rem;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: var(--font-display);
            font-weight: 800;
            font-size: 1.25rem;
            color: #fff;
            background: var(--primary-gradient);
            flex-shrink: 0;
        }

        .timeline {
            position: relative;
            padding-left: 2rem;
            margin-top: 0.5rem;
        }

        .timeline::before {
            content: '';
            position: absolute;
            left: 10px;
            top: 0;
            bottom: 0;
            width: 2px;
            background-color: var(--surface-high);
            border-radius: 1px;
        }

        .timeline-item {
            position: relative;
            padding-bottom: 1.25rem;
        }

        .timeline-item:last-child {
            padding-bottom: 0;
        }

        .timeline-marker {
            position: absolute;
            left: -1.65rem;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            border: 2px solid var(--surface-lowest);
            background-color: var(--primary);
        }

        .timeline-marker--active {
            background-color: #22c55e;
            box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.2);
            animation: pulse 2s infinite;
        }

        .timeline-content {
            padding: 0.85rem 1.15rem;
            background-color: var(--surface-low);
            border-radius: 0.75rem;
            transition: background-color 0.2s ease;
        }

        .timeline-content:hover {
            background-color: var(--surface-high);
        }

        .timeline-title {
            font-family: var(--font-display);
            font-weight: 700;
            font-size: 0.95rem;
            color: var(--text-main);
            margin-bottom: 0.25rem;
        }

        .btn-action {
            border: none;
            transition: all 0.2s ease;
        }

        .btn-action:hover {
            transform: scale(1.02);
        }

        .records-count {
            font-family: var(--font-display);
            font-weight: 700;
            font-size: 0.75rem;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            color: var(--text-main);
            opacity: 0.5;
        }

        .empty-state-icon {
            font-size: 4rem;
            color: var(--surface-high);
            display: block;
            margin-bottom: 1rem;
        }

        @@keyframes pulse {
            0% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.35); }
            70% { box-shadow: 0 0 0 8px rgba(34, 197, 94, 0); }
            100% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0); }
        }
    </style>
}

<div class="container-fluid py-4">

    @* Back *@
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none text-muted fw-semibold d-inline-flex align-items-center gap-2 btn-action">
            <i class="bi bi-arrow-left"></i> Back to Attendance
        </a>
    </div>

    @* Header *@
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-5">
        <div class="d-flex align-items-center gap-3">
            <div class="member-avatar">@memberInitial</div>
            <div>
                <h1 class="display-6 fw-extrabold text-main mb-1" style="font-family: var(--font-display); letter-spacing: -1.5px;">
                    Attendance History
                </h1>
                <p class="text-muted mb-0 d-flex flex-wrap align-items-center gap-2">
                    <span><i class="bi bi-person-fill me-1"></i>@memberName</span>
                    <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-2 fw-semibold">ID #@memberId</span>
                </p>
            </div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="CheckIn" class="btn btn-primary rounded-pill text-white px-4 py-2.5 d-flex align-items-center gap-2 btn-action" style="background: var(--primary-gradient); border: none; font-weight: 600; font-family: var(--font-display);">
                <i class="bi bi-box-arrow-in-right"></i> Check-In
            </a>
            <a asp-action="Index" class="btn rounded-pill px-4 py-2.5 btn-action fw-semibold d-flex align-items-center gap-2" style="background-color: var(--surface-low); color: var(--text-main); font-family: var(--font-display);">
                <i class="bi bi-calendar-day"></i> Today
            </a>
        </div>
    </div>

    @* Stats *@
    @if (stats != null)
    {
        <div class="row g-4 mb-5">
            <div class="col-xl-4 col-md-6">
                <div class="card stat-mini-card p-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-muted fw-bold text-uppercase small" style="font-family: var(--font-body); letter-spacing: 0.5px;">Total Visits</span>
                            <div class="stat-kpi text-primary">@stats.TotalCheckIns</div>
                        </div>
                        <div class="stat-icon-wrap bg-primary bg-opacity-10 text-primary">
                            <i class="bi bi-calendar-check-fill"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-4 col-md-6">
                <div class="card stat-mini-card p-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-muted fw-bold text-uppercase small" style="font-family: var(--font-body); letter-spacing: 0.5px;">Avg Duration</span>
                            <div class="stat-kpi text-success">
                                @(stats.AverageDurationMinutes > 0 ? $"{(int)stats.AverageDurationMinutes} min" : "N/A")
                            </div>
                        </div>
                        <div class="stat-icon-wrap bg-success bg-opacity-10 text-success">
                            <i class="bi bi-clock-fill"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-4 col-md-12">
                <div class="card stat-mini-card p-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-muted fw-bold text-uppercase small" style="font-family: var(--font-body); letter-spacing: 0.5px;">Total Time Spent</span>
                            <div class="stat-kpi" style="color: #e67e22;">
                                @if (stats.AverageDurationMinutes > 0 && stats.TotalCheckIns > 0)
                                {
                                    var totalHours = (stats.AverageDurationMinutes * stats.TotalCheckIns) / 60;
                                    @($"{totalHours:0.#} hrs")
                                }
                                else
                                {
                                    @:N/A
                                }
                            </div>
                        </div>
                        <div class="stat-icon-wrap" style="background-color: rgba(230, 126, 34, 0.12); color: #e67e22;">
                            <i class="bi bi-hourglass-split"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    @* Visit history *@
    <div class="card bg-surface-lowest border-0 rounded-4 p-4 history-table-card">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="h5 fw-bold text-main mb-0" style="font-family: var(--font-display); letter-spacing: -0.5px;">
                <i class="bi bi-list-check me-2 text-primary"></i>Visit History
            </h2>
            <span class="records-count">@recordCount records</span>
        </div>

        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle border-0 mb-0">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Day</th>
                            <th>Check-In</th>
                            <th>Check-Out</th>
                            <th>Duration</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderByDescending(m => m.CheckInTime))
                        {
                            <tr class="@(item.IsOpen ? "row-active" : "")">
                                <td class="fw-bold">@item.CheckInTime.ToString("MMM dd, yyyy")</td>
                                <td>
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3 py-2 fw-semibold">
                                        @item.CheckInTime.ToString("dddd")
                                    </span>
                                </td>
                                <td>
                                    <span class="text-success fw-semibold">
                                        <i class="bi bi-box-arrow-in-right me-1"></i>@item.FormattedCheckIn
                                    </span>
                                </td>
                                <td>
                                    @if (item.CheckOutTime.HasValue)
                                    {
                                        <span class="text-danger fw-semibold">
                                            <i class="bi bi-box-arrow-right me-1"></i>@item.FormattedCheckOut
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill px-3 py-2 fw-semibold">
                                            <i class="bi bi-arrow-repeat me-1"></i>Active
                                        </span>
                                    }
                                </td>
                                <td>
                                    <span class="badge @(item.IsOpen ? "bg-primary bg-opacity-10 text-primary" : "bg-secondary bg-opacity-10 text-secondary") rounded-pill px-3 py-2 fw-semibold">
                                        @item.Duration
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @item.StatusBadgeClass rounded-pill px-3 py-2 fw-semibold">
                                        <i class="bi @item.StatusIcon me-1"></i>@item.StatusText
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @* Timeline *@
            <div class="mt-5 pt-4" style="border-top: 1px solid rgba(28, 27, 27, 0.06);">
                <h3 class="h6 fw-bold text-main mb-4" style="font-family: var(--font-display); letter-spacing: -0.25px;">
                    <i class="bi bi-clock-history text-primary me-2"></i>Recent Activity Timeline
                </h3>
                <div class="timeline">
                    @foreach (var item in Model.OrderByDescending(m => m.CheckInTime).Take(10))
                    {
                        <div class="timeline-item">
                            <div class="timeline-marker @(item.IsOpen ? "timeline-marker--active" : "")"></div>
                            <div class="timeline-content">
                                <div class="timeline-title">@item.CheckInTime.ToString("MMM dd, yyyy")</div>
                                <p class="mb-0 text-muted small">
                                    <i class="bi bi-clock me-1"></i>
                                    @item.FormattedCheckIn — @item.FormattedCheckOut
                                    <span class="mx-2 opacity-50">|</span>
                                    <i class="bi bi-stopwatch me-1"></i>
                                    @item.Duration
                                </p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-clipboard2-x empty-state-icon"></i>
                <h4 class="fw-bold text-main mb-2" style="font-family: var(--font-display);">No attendance records found</h4>
                <p class="text-muted mb-4">This member hasn't visited the gym yet.</p>
                <a asp-action="CheckIn" class="btn btn-primary rounded-pill text-white px-4 py-2 btn-action" style="background: var(--primary-gradient); border: none; font-weight: 600; font-family: var(--font-display);">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Record First Visit
                </a>
            </div>
        }
    </div>
</div>
