
@model GymSystem.Web.ViewModels.Attendance.CheckInViewModel

@{
    ViewData["Title"] = "Member Check-In";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-lg-6 mx-auto">
            @* Quick Check-In Card *@
            <div class="card shadow mb-4">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-sign-in-alt me-2"></i>Member Check-In
                    </h4>
                </div>
                <div class="card-body">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div asp-validation-summary="All" class="alert alert-danger"></div>
                    }

                    <form asp-action="CheckIn" method="post" id="checkInForm">
                        @Html.AntiForgeryToken()

                        <div class="mb-4">
                            <label asp-for="MemberId" class="form-label fw-bold">
                                <i class="fas fa-user me-2"></i>Select Member
                            </label>
                            <select asp-for="MemberId"
                                    asp-items="Model.Members"
                                    class="form-select form-select-lg"
                                    id="memberSelect">
                                <option value="">-- Choose a member --</option>
                            </select>
                            <span asp-validation-for="MemberId" class="text-danger small"></span>
                            <div class="form-text">
                                <i class="fas fa-info-circle me-1"></i>
                                Only active members will be able to check in.
                            </div>
                        </div>

                        @* Selected Member Preview *@
                        <div id="memberPreview" class="d-none mb-4">
                            <div class="card bg-light">
                                <div class="card-body">
                                    <div class="d-flex align-items-center">
                                        <div class="me-3">
                                            <div class="avatar-lg bg-primary rounded-circle d-flex align-items-center justify-content-center text-white"
                                                 style="width: 60px; height: 60px;">
                                                <span id="memberInitial" style="font-size: 1.5rem;"></span>
                                            </div>
                                        </div>
                                        <div>
                                            <h5 id="memberFullName" class="mb-1"></h5>
                                            <span class="badge bg-success">
                                                <i class="fas fa-check-circle me-1"></i>Ready to Check-In
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-2"></i>Back to List
                            </a>
                            <button type="submit" class="btn btn-success btn-lg" id="checkInBtn" disabled>
                                <i class="fas fa-sign-in-alt me-2"></i>Check In
                            </button>
                        </div>
                    </form>
                </div>
                <div class="card-footer bg-light">
                    <div class="d-flex justify-content-between align-items-center">
                        <small class="text-muted">
                            <i class="fas fa-clock me-1"></i>
                            Current Time: <span id="currentTime">@DateTime.Now.ToString("hh:mm:ss tt")</span>
                        </small>
                        <small class="text-muted">
                            <i class="fas fa-calendar me-1"></i>
                            @DateTime.Now.ToString("dddd, MMM dd, yyyy")
                        </small>
                    </div>
                </div>
            </div>

            @* Quick Tips Card *@
            <div class="card shadow">
                <div class="card-header bg-info text-white">
                    <h6 class="mb-0">
                        <i class="fas fa-lightbulb me-2"></i>Check-In Tips
                    </h6>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2">
                            <i class="fas fa-check-circle text-success me-2"></i>
                            Members must have an active membership to check in.
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-check-circle text-success me-2"></i>
                            A member can only have one active check-in at a time.
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-check-circle text-success me-2"></i>
                            Check-out can be done from the attendance list later.
                        </li>
                        <li>
                            <i class="fas fa-check-circle text-success me-2"></i>
                            All check-ins are recorded with exact time stamps.
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .form-select-lg {
            font-size: 1.1rem;
        }

        #memberPreview {
            animation: fadeIn 0.3s ease-in;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Update current time every second
        function updateTime() {
            var now = new Date();
            var timeString = now.toLocaleTimeString('en-US', {
                hour: '2-digit',
                minute: '2-digit',
                second: '2-digit'
            });
            document.getElementById('currentTime').textContent = timeString;
        }
        setInterval(updateTime, 1000);
        updateTime();

        // Member selection preview
        document.getElementById('memberSelect').addEventListener('change', function() {
            var selectedOption = this.options[this.selectedIndex];
            var memberName = selectedOption.text;
            var preview = document.getElementById('memberPreview');
            var checkInBtn = document.getElementById('checkInBtn');

            if (this.value && memberName !== '-- Choose a member --') {
                // Show preview
                preview.classList.remove('d-none');
                document.getElementById('memberFullName').textContent = memberName;
                document.getElementById('memberInitial').textContent = memberName.charAt(0).toUpperCase();

                // Enable button
                checkInBtn.disabled = false;
            } else {
                // Hide preview
                preview.classList.add('d-none');
                checkInBtn.disabled = true;
            }
        });

        // Prevent double submission
        document.getElementById('checkInForm').addEventListener('submit', function() {
            var btn = document.getElementById('checkInBtn');
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Checking In...';
        });
    </script>
}