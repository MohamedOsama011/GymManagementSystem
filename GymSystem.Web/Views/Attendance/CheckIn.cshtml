@model GymSystem.Web.ViewModels.Attendance.CheckInViewModel

@{
    ViewData["Title"] = "Member Check-In";
    var todayLabel = DateTime.Now.ToString("dddd, MMMM d, yyyy");
}

@section Styles {
    <style>
        .form-card {
            box-shadow: 0px 20px 40px rgba(28, 27, 27, 0.03);
            background-color: var(--surface-lowest);
        }

        .form-label {
            font-family: var(--font-display);
            font-weight: 600;
            font-size: 0.875rem;
            color: var(--text-main);
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            opacity: 0.8;
        }

        .kinetic-input, .kinetic-select {
            background-color: var(--surface-low) !important;
            border: 2px solid transparent !important;
            border-radius: 12px !important;
            padding: 12px 18px !important;
            color: var(--text-main) !important;
            font-family: var(--font-body);
            transition: all 0.2s ease !important;
            outline: none !important;
        }

        .kinetic-select-lg {
            font-size: 1.05rem !important;
            padding: 14px 18px !important;
        }

        .kinetic-input:focus, .kinetic-select:focus {
            border-color: var(--primary) !important;
            background-color: var(--surface-lowest) !important;
            box-shadow: 0px 0px 0px 4px rgba(0, 74, 232, 0.15) !important;
        }

        .btn-action {
            border: none;
            transition: all 0.2s ease;
        }

        .btn-action:hover:not(:disabled) {
            transform: scale(1.02);
        }

        .member-preview-card {
            background-color: var(--surface-low);
            border-radius: 1rem;
            padding: 1.25rem;
            animation: fadeIn 0.3s ease-in;
        }

        .member-preview-avatar {
            width: 56px;
            height: 56px;
            border-radius: 0.75rem;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: var(--font-display);
            font-weight: 800;
            font-size: 1.35rem;
            color: #fff;
            background: var(--primary-gradient);
            flex-shrink: 0;
        }

        .live-clock-card {
            background-color: var(--surface-low);
            border-radius: 1rem;
            padding: 1rem 1.25rem;
        }

        .live-clock-time {
            font-family: var(--font-display);
            font-weight: 800;
            font-size: 1.5rem;
            letter-spacing: -0.5px;
            color: var(--text-main);
        }

        .stat-chip {
            background-color: var(--surface-lowest);
            border-radius: 0.75rem;
            padding: 0.85rem 1rem;
            box-shadow: 0px 12px 24px rgba(28, 27, 27, 0.03);
        }

        .stat-chip-value {
            font-family: var(--font-display);
            font-weight: 800;
            font-size: 1.35rem;
            letter-spacing: -0.5px;
            line-height: 1.1;
        }

        .tip-item {
            font-size: 0.9rem;
        }

        .stat-icon-wrap {
            width: 44px;
            height: 44px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.15rem;
            flex-shrink: 0;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(-8px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
}

<div class="container-fluid py-4">

    @* Back *@
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none text-muted fw-semibold d-inline-flex align-items-center gap-2 btn-action">
            <i class="bi bi-arrow-left"></i> Back to Attendance
        </a>
    </div>

    @* Header *@
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-5">
        <div>
            <h1 class="display-6 fw-extrabold text-main mb-2" style="font-family: var(--font-display); letter-spacing: -1.5px;">
                Member Check-In
            </h1>
            <p class="text-muted mb-0">
                <i class="bi bi-calendar-date me-2"></i>@todayLabel
            </p>
        </div>
        <div class="live-clock-card d-flex align-items-center gap-3">
            <div class="stat-icon-wrap bg-primary bg-opacity-10 text-primary rounded-3 p-2">
                <i class="bi bi-clock-fill"></i>
            </div>
            <div>
                <div class="text-muted small text-uppercase fw-bold" style="font-family: var(--font-display); letter-spacing: 0.5px; font-size: 0.65rem;">Live Time</div>
                <div class="live-clock-time" id="currentTime">@DateTime.Now.ToString("hh:mm:ss tt")</div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        @* Form column *@
        <div class="col-lg-8">
            <div class="card border-0 rounded-4 p-4 p-md-5 form-card">
                <form asp-action="CheckIn" method="post" id="checkInForm">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-3 bg-danger bg-opacity-10 text-danger p-3 mb-4" role="alert"></div>

                    <div class="mb-4">
                        <label class="form-label" for="memberSearch">
                            <i class="bi bi-search me-1"></i> Search Member
                        </label>
                        <input type="text"
                               id="memberSearch"
                               class="form-control kinetic-input"
                               placeholder="Type to filter members..."
                               autocomplete="off" />
                    </div>

                    <div class="mb-4">
                        <label asp-for="MemberId" class="form-label">
                            <i class="bi bi-person-fill me-1"></i> Select Member
                        </label>
                        <select asp-for="MemberId"
                                asp-items="Model.Members"
                                class="form-select kinetic-select kinetic-select-lg"
                                id="memberSelect">
                            <option value="">— Choose a member —</option>
                        </select>
                        <span asp-validation-for="MemberId" class="text-danger small mt-2 d-block"></span>
                        <p class="text-muted small mt-2 mb-0">
                            <i class="bi bi-info-circle me-1"></i>
                            Only members without an open check-in can check in again.
                        </p>
                    </div>

                    @* Member preview *@
                    <div id="memberPreview" class="d-none mb-4">
                        <div class="member-preview-card">
                            <div class="d-flex align-items-center gap-3">
                                <div class="member-preview-avatar" id="memberAvatar">
                                    <span id="memberInitial">?</span>
                                </div>
                                <div>
                                    <h5 id="memberFullName" class="fw-bold text-main mb-1" style="font-family: var(--font-display);"></h5>
                                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2 fw-semibold">
                                        <i class="bi bi-check-circle-fill me-1"></i>Ready to check in
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-stretch align-items-sm-center gap-3 pt-2">
                        <a asp-action="Index"
                           class="btn rounded-pill px-4 py-2.5 btn-action fw-semibold text-center"
                           style="background-color: var(--surface-low); color: var(--text-main); font-family: var(--font-display);">
                            Cancel
                        </a>
                        <button type="submit"
                                class="btn btn-primary rounded-pill text-white px-5 py-2.5 btn-action d-flex align-items-center justify-content-center gap-2"
                                id="checkInBtn"
                                disabled
                                style="background: var(--primary-gradient); font-weight: 600; font-family: var(--font-display);">
                            <i class="bi bi-box-arrow-in-right"></i>
                            <span id="checkInBtnText">Check In Member</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>

        @* Sidebar *@
        <div class="col-lg-4">
            <div class="d-flex flex-column gap-4 h-100">
                @* Quick stats *@
                <div class="row g-3">
                    <div class="col-6">
                        <div class="stat-chip text-center">
                            <div class="text-muted small text-uppercase fw-bold mb-1" style="font-size: 0.65rem; letter-spacing: 0.5px;">Available</div>
                            <div class="stat-chip-value text-primary">@Model.ActiveMembersCount</div>
                            <div class="text-muted small">members</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="stat-chip text-center">
                            <div class="text-muted small text-uppercase fw-bold mb-1" style="font-size: 0.65rem; letter-spacing: 0.5px;">Today</div>
                            <div class="stat-chip-value text-success">@Model.TotalCheckInsToday</div>
                            <div class="text-muted small">check-ins</div>
                        </div>
                    </div>
                </div>

                @* Tips *@
                <div class="card border-0 rounded-4 p-4 bg-surface-low flex-grow-1">
                    <h5 class="fw-bold text-main mb-3" style="font-family: var(--font-display);">
                        <i class="bi bi-lightbulb text-primary me-2"></i>Check-In Tips
                    </h5>
                    <ul class="list-unstyled d-flex flex-column gap-3 text-muted mb-0">
                        <li class="tip-item d-flex align-items-start gap-2">
                            <i class="bi bi-check-circle-fill text-success mt-1 flex-shrink-0"></i>
                            <span>Members must exist in the directory before they can check in.</span>
                        </li>
                        <li class="tip-item d-flex align-items-start gap-2">
                            <i class="bi bi-check-circle-fill text-success mt-1 flex-shrink-0"></i>
                            <span>A member can only have one active check-in at a time.</span>
                        </li>
                        <li class="tip-item d-flex align-items-start gap-2">
                            <i class="bi bi-check-circle-fill text-success mt-1 flex-shrink-0"></i>
                            <span>Check-out can be done from the attendance list or dashboard.</span>
                        </li>
                        <li class="tip-item d-flex align-items-start gap-2">
                            <i class="bi bi-check-circle-fill text-success mt-1 flex-shrink-0"></i>
                            <span>All check-ins are recorded with exact timestamps.</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        (function () {
            var memberSelect = document.getElementById('memberSelect');
            var memberSearch = document.getElementById('memberSearch');
            var preview = document.getElementById('memberPreview');
            var checkInBtn = document.getElementById('checkInBtn');
            var checkInBtnText = document.getElementById('checkInBtnText');
            var form = document.getElementById('checkInForm');
            var placeholderText = '— Choose a member —';

            var allOptions = Array.from(memberSelect.options).map(function (opt) {
                return { value: opt.value, text: opt.text, element: opt.cloneNode(true) };
            });

            function updateClock() {
                var now = new Date();
                document.getElementById('currentTime').textContent = now.toLocaleTimeString('en-US', {
                    hour: '2-digit',
                    minute: '2-digit',
                    second: '2-digit'
                });
            }
            setInterval(updateClock, 1000);
            updateClock();

            function rebuildSelect(filter) {
                var query = (filter || '').trim().toLowerCase();
                var selected = memberSelect.value;
                memberSelect.innerHTML = '';

                allOptions.forEach(function (opt) {
                    if (!opt.value) {
                        memberSelect.appendChild(opt.element.cloneNode(true));
                        return;
                    }
                    if (!query || opt.text.toLowerCase().includes(query)) {
                        memberSelect.appendChild(opt.element.cloneNode(true));
                    }
                });

                if (selected && Array.from(memberSelect.options).some(function (o) { return o.value === selected; })) {
                    memberSelect.value = selected;
                } else {
                    memberSelect.value = '';
                }
                updatePreview();
            }

            function updatePreview() {
                var selectedOption = memberSelect.options[memberSelect.selectedIndex];
                var memberName = selectedOption ? selectedOption.text : '';

                if (memberSelect.value && memberName !== placeholderText) {
                    preview.classList.remove('d-none');
                    document.getElementById('memberFullName').textContent = memberName;
                    document.getElementById('memberInitial').textContent = memberName.charAt(0).toUpperCase();
                    checkInBtn.disabled = false;
                } else {
                    preview.classList.add('d-none');
                    checkInBtn.disabled = true;
                }
            }

            memberSearch.addEventListener('input', function () {
                rebuildSelect(this.value);
            });

            memberSelect.addEventListener('change', updatePreview);

            form.addEventListener('submit', function () {
                checkInBtn.disabled = true;
                checkInBtnText.textContent = 'Checking in...';
            });

            updatePreview();
        })();
    </script>
}
