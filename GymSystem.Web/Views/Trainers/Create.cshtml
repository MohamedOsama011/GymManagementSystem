@model GymSystem.Web.ViewModels.Trainers.TrainerFormViewModel

@{
    ViewData["Title"] = "Add Trainer";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0">Add Trainer</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label fw-semibold"></label>
                            <input asp-for="FullName" class="form-control" placeholder="Enter full name" />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="JobTitle" class="form-label fw-semibold"></label>
                            <input asp-for="JobTitle" class="form-control" placeholder="Enter job title" />
                            <span asp-validation-for="JobTitle" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Photo" class="form-label fw-semibold"></label>
                            <input asp-for="Photo" class="form-control" type="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
                            <span asp-validation-for="Photo" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="SelectedSpecialtyIds" class="form-label fw-semibold"></label>
                            <select asp-for="SelectedSpecialtyIds" class="form-select" asp-items="Model.AllSpecialties" multiple></select>
                            <small class="text-muted">Hold Ctrl to select multiple specialties.</small>
                            <span asp-validation-for="SelectedSpecialtyIds" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-action="Index" class="btn btn-light me-md-2">Cancel</a>
                            <button type="submit" class="btn btn-primary px-5">Save Trainer</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
