@model IEnumerable<GymSystem.Web.ViewModels.Trainers.TrainerListViewModel>

@{
    ViewData["Title"] = "Trainers";
}
@section Styles {
    <style>
        .members-table-card {
            box-shadow: 0px 20px 40px rgba(28, 27, 27, 0.03);
        }

        .table {
            border-collapse: separate;
            border-spacing: 0 4px;
        }

            .table th {
                border: none !important;
                font-family: var(--font-display);
                font-weight: 700;
                text-transform: uppercase;
                font-size: 0.75rem;
                letter-spacing: 0.75px;
                color: var(--text-main);
                opacity: 0.6;
                padding: 16px 24px !important;
            }

            .table td {
                border: none !important;
                padding: 18px 24px !important;
                font-family: var(--font-body);
                color: var(--text-main);
            }

            .table tbody tr {
                border-radius: 12px;
                transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
            }

                .table tbody tr:hover {
                    background-color: var(--surface-low) !important;
                }

        .member-avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: var(--font-display);
            font-weight: 700;
            font-size: 0.875rem;
            color: var(--primary);
            background-color: rgba(0, 74, 232, 0.1);
        }

        .btn-action {
            border: none;
            transition: all 0.2s ease;
        }

            .btn-action:hover {
                transform: scale(1.02);
            }
    </style>
}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 > Trainers</h2>
        <div>
            <a asp-action="Create" class="btn btn-primary rounded-pill text-white px-4 py-2.5 d-flex align-items-center gap-2 btn-action" style="background: var(--primary-gradient); font-weight: 600; font-family: var(--font-display);">
                <i class="bi bi-plus-lg"></i> Add New Trainer
            </a>
        </div>
    </div>

    <div class="table-responsive shadow rounded">
        <table class="table table-hover align-middle mb-0">
            <thead >
                <tr>
                    <th>Full Name</th>
                    <th>Job Title</th>
                    <th>Members</th>
                    <th>Specialties</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold">@item.FullName</td>
                        <td>@item.JobTitle</td>
                        <td>@item.MemberCount</td>
                        <td>@(item.Specialties.Any() ? string.Join(", ", item.Specialties) : "None")</td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Edit</a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Are you sure you want to delete this trainer?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
