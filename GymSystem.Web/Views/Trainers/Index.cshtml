@model IEnumerable<GymSystem.Web.ViewModels.Trainers.TrainerListViewModel>

@{
    ViewData["Title"] = "Trainers";

    string GetSpecialtyColor(string specialty)
    {
        var name = specialty?.ToLower() ?? "";
        if (name.Contains("hiit") || name.Contains("cardio")) return "#e74c3c";
        if (name.Contains("yoga") || name.Contains("mind") || name.Contains("body")) return "#e67e22";
        if (name.Contains("cycling") || name.Contains("spin")) return "#004ae8";
        if (name.Contains("strength") || name.Contains("weight")) return "#9e3d00";
        if (name.Contains("box")) return "#2c3e50";
        if (name.Contains("swim") || name.Contains("aqua")) return "#1abc9c";
        if (name.Contains("dance") || name.Contains("zumba")) return "#9b59b6";
        if (name.Contains("pilates") || name.Contains("stretch")) return "#27ae60";
        return "#004ae8";
    }
}

@section Styles {
    <style>
        .trainer-card {
            background-color: var(--surface-lowest);
            border: none;
            border-radius: 1rem;
            box-shadow: 0px 20px 40px rgba(28, 27, 27, 0.03);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            display: flex;
            flex-direction: column;
            height: 100%;
            padding: 1.35rem;
            position: relative;
        }

        .trainer-card:hover {
            transform: translateY(-4px);
            box-shadow: 0px 24px 48px rgba(28, 27, 27, 0.07);
        }

        .trainer-photo-wrap {
            position: relative;
            flex-shrink: 0;
        }

        .trainer-photo {
            width: 72px;
            height: 72px;
            border-radius: 0.85rem;
            object-fit: cover;
            display: block;
        }

        .trainer-photo-fallback {
            width: 72px;
            height: 72px;
            border-radius: 0.85rem;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: var(--font-display);
            font-weight: 800;
            font-size: 1.5rem;
            color: #fff;
            background: var(--primary-gradient);
        }

        .status-dot {
            position: absolute;
            bottom: 4px;
            right: 4px;
            width: 14px;
            height: 14px;
            border-radius: 50%;
            border: 2px solid var(--surface-lowest);
        }

        .status-dot--active { background-color: #22c55e; }
        .status-dot--away { background-color: #f59e0b; }

        .trainer-name {
            font-family: var(--font-display);
            font-weight: 800;
            font-size: 1.2rem;
            color: var(--text-main);
            letter-spacing: -0.5px;
            line-height: 1.2;
            margin: 0;
        }

        .trainer-rating {
            font-family: var(--font-display);
            font-weight: 700;
            font-size: 0.95rem;
            color: var(--primary);
            white-space: nowrap;
        }

        .role-badge {
            display: inline-flex;
            align-items: center;
            padding: 5px 12px;
            border-radius: 50px;
            font-size: 0.65rem;
            font-weight: 700;
            letter-spacing: 0.75px;
            text-transform: uppercase;
            font-family: var(--font-display);
            background-color: rgba(0, 74, 232, 0.1);
            color: var(--primary);
        }

        .specialty-badge {
            display: inline-flex;
            align-items: center;
            padding: 5px 12px;
            border-radius: 50px;
            font-size: 0.65rem;
            font-weight: 700;
            letter-spacing: 0.75px;
            text-transform: uppercase;
            font-family: var(--font-display);
            background-color: var(--surface-low);
            color: var(--text-main);
            opacity: 0.75;
        }

        .load-track {
            height: 8px;
            border-radius: 4px;
            background-color: var(--surface-low);
            overflow: hidden;
        }

        .load-fill {
            height: 100%;
            border-radius: 4px;
            transition: width 0.5s ease;
        }

        .btn-view-profile {
            flex: 1;
            border: 2px solid rgba(0, 74, 232, 0.25);
            background-color: var(--surface-lowest);
            color: var(--primary);
            border-radius: 10px;
            padding: 11px 14px;
            font-family: var(--font-display);
            font-weight: 600;
            font-size: 0.875rem;
            text-align: center;
            text-decoration: none;
            transition: all 0.2s ease;
        }

        .btn-view-profile:hover {
            background-color: rgba(0, 74, 232, 0.06);
            color: var(--primary);
            border-color: rgba(0, 74, 232, 0.4);
        }

        .btn-edit-schedule {
            flex: 1;
            border: none;
            background-color: var(--surface-low);
            color: var(--text-main);
            border-radius: 10px;
            padding: 11px 14px;
            font-family: var(--font-display);
            font-weight: 600;
            font-size: 0.875rem;
            text-align: center;
            text-decoration: none;
            transition: all 0.2s ease;
        }

        .btn-edit-schedule:hover {
            background-color: var(--surface-high);
            color: var(--text-main);
        }

        .card-menu-btn {
            width: 32px;
            height: 32px;
            border: none;
            border-radius: 50%;
            background: transparent;
            color: var(--text-main);
            opacity: 0.45;
            transition: all 0.2s ease;
        }

        .card-menu-btn:hover {
            opacity: 1;
            background-color: var(--surface-low);
        }

        .filter-select {
            background-color: var(--surface-low) !important;
            border: none !important;
            border-radius: 12px !important;
            padding: 12px 18px !important;
            font-family: var(--font-body);
            font-weight: 500;
            color: var(--text-main) !important;
            min-width: 200px;
        }

        .filter-label {
            font-family: var(--font-display);
            font-weight: 700;
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--text-main);
            opacity: 0.5;
            margin-bottom: 8px;
        }

        .btn-action {
            border: none;
            transition: all 0.2s ease;
        }

        .btn-action:hover {
            transform: scale(1.02);
        }

        .empty-state-icon {
            font-size: 4rem;
            color: var(--surface-high);
            display: block;
            margin-bottom: 1rem;
        }
    </style>
}

<div class="container-fluid py-4">

    @* Header *@
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-end gap-3 mb-5">
        <div>
            <h1 class="display-6 fw-extrabold text-main mb-1" style="font-family: var(--font-display); letter-spacing: -1.5px;">
                Trainers
            </h1>
            <p class="text-muted mb-0">Manage coaches, schedules, and weekly workload.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary rounded-pill text-white px-4 py-2.5 d-flex align-items-center gap-2 btn-action" style="background: var(--primary-gradient); border: none; font-weight: 600; font-family: var(--font-display);">
            <i class="bi bi-plus-lg"></i> Add New Trainer
        </a>
    </div>

    @if (Model.Any())
    {
        @* Filter *@
        <div class="d-flex flex-wrap gap-4 mb-4">
            <div>
                <div class="filter-label">Filter Specialty</div>
                <select id="filterSpecialty" class="form-select filter-select">
                    <option value="">All Specialties</option>
                    @foreach (var spec in Model.SelectMany(t => t.Specialties).Distinct().OrderBy(s => s))
                    {
                        <option value="@spec">@spec</option>
                    }
                </select>
            </div>
            <div>
                <div class="filter-label">Filter Status</div>
                <select id="filterStatus" class="form-select filter-select">
                    <option value="">All Status</option>
                    <option value="active">Active</option>
                    <option value="away">Away</option>
                </select>
            </div>
        </div>

        <div class="row g-4" id="trainerGrid">
            @foreach (var item in Model)
            {
                var specColor = GetSpecialtyColor(item.PrimarySpecialty);
                var fallbackInitial = string.IsNullOrWhiteSpace(item.FullName)
                    ? "?"
                    : item.FullName.Trim().Substring(0, 1).ToUpper();
                var photoUrl = string.IsNullOrWhiteSpace(item.PhotoPath)
                    ? null
                    : Url.Content(item.PhotoPath.StartsWith("~/", StringComparison.Ordinal)
                        ? item.PhotoPath
                        : $"~{item.PhotoPath}");

                <div class="col-xl-4 col-lg-6 col-md-6 trainer-grid-item"
                     data-specialty="@item.PrimarySpecialty"
                     data-status="@(item.IsActive ? "active" : "away")">
                    <div class="trainer-card">
                        @* Card menu *@
                        <div class="position-absolute top-0 end-0 p-2">
                            <div class="dropdown">
                                <button class="card-menu-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-three-dots"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3">
                                    <li>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="dropdown-item py-2">
                                            <i class="bi bi-pencil-fill me-2"></i> Edit Trainer
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post"
                                              onsubmit="return confirm('Delete this trainer?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item py-2 text-danger">
                                                <i class="bi bi-trash-fill me-2"></i> Delete
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        </div>

                        @* Header: photo + name + rating *@
                        <div class="d-flex gap-3 mb-3 pe-4">
                            <div class="trainer-photo-wrap">
                                @if (!string.IsNullOrWhiteSpace(photoUrl))
                                {
                                    <img src="@photoUrl" alt="@item.FullName" class="trainer-photo" />
                                }
                                else
                                {
                                    <div class="trainer-photo-fallback">@fallbackInitial</div>
                                }
                                <span class="status-dot @(item.IsActive ? "status-dot--active" : "status-dot--away")"
                                      title="@(item.IsActive ? "Active" : "Away")"></span>
                            </div>
                            <div class="flex-grow-1 min-width-0">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <h3 class="trainer-name text-truncate">@item.FullName</h3>
                                    <span class="trainer-rating">
                                        <i class="bi bi-star-fill me-1"></i>@item.Rating.ToString("0.0")
                                    </span>
                                </div>
                                <div class="d-flex flex-wrap gap-2 mt-2">
                                    <span class="role-badge">@item.RoleBadgeText</span>
                                    <span class="specialty-badge" style="background-color: @(specColor)12; color: @specColor;">
                                        @item.PrimarySpecialty.ToUpper()
                                    </span>
                                </div>
                            </div>
                        </div>

                        @* Weekly load *@
                        <div class="mb-4">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-muted fw-semibold" style="font-size: 0.8rem; font-family: var(--font-display);">Weekly Load</span>
                                <span class="fw-bold" style="font-size: 0.85rem; font-family: var(--font-display);">@item.WeeklyHoursDisplay</span>
                            </div>
                            <div class="load-track">
                                <div class="load-fill" style="width: @(item.WeeklyLoadPercent)%; background-color: @item.LoadBarColor;"></div>
                            </div>
                            <p class="text-muted small mb-0 mt-2">
                                @item.MemberCount member@(item.MemberCount == 1 ? "" : "s") · @item.ClassCount class@(item.ClassCount == 1 ? "" : "es")
                            </p>
                        </div>

                        @* Actions *@
                        <div class="d-flex gap-2 mt-auto">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn-view-profile">
                                View Profile
                            </a>
                            <a asp-controller="Classes" asp-action="Index" class="btn-edit-schedule"
                               data-trainer="@item.FullName">
                                Edit Schedule
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card bg-surface-lowest border-0 rounded-4 p-5 text-center" style="box-shadow: 0px 20px 40px rgba(28, 27, 27, 0.03);">
            <i class="bi bi-person-badge empty-state-icon"></i>
            <h4 class="fw-bold text-main mb-2" style="font-family: var(--font-display);">No trainers yet</h4>
            <p class="text-muted mb-4">Add your first coach to start building the team.</p>
            <a asp-action="Create" class="btn btn-primary rounded-pill text-white px-4 py-2 btn-action" style="background: var(--primary-gradient); border: none; font-weight: 600; font-family: var(--font-display);">
                <i class="bi bi-plus-lg me-1"></i> Add New Trainer
            </a>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const filterSpecialty = document.getElementById("filterSpecialty");
            const filterStatus = document.getElementById("filterStatus");
            const items = document.querySelectorAll(".trainer-grid-item");

            if (!filterSpecialty) return;

            function applyFilters() {
                const specVal = (filterSpecialty.value || "").toLowerCase();
                const statusVal = (filterStatus.value || "").toLowerCase();

                items.forEach(item => {
                    const spec = (item.dataset.specialty || "").toLowerCase();
                    const status = (item.dataset.status || "").toLowerCase();
                    const matchSpec = !specVal || spec === specVal;
                    const matchStatus = !statusVal || status === statusVal;
                    item.style.display = (matchSpec && matchStatus) ? "" : "none";
                });
            }

            filterSpecialty.addEventListener("change", applyFilters);
            filterStatus.addEventListener("change", applyFilters);

            document.querySelectorAll("[data-trainer]").forEach(link => {
                link.addEventListener("click", function () {
                    sessionStorage.setItem("classesFilterTrainer", this.dataset.trainer || "");
                });
            });
        });
    </script>
}
