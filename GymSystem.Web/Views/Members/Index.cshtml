@using GymSystem.Models.DTOs;
@using GymSystem.Web.ViewModels.Members
@model IEnumerable<MemberListViewModel>

@{
    ViewData["Title"] = "Members List";
}
@section Styles {
    <style>
        .members-table-card {
            box-shadow: 0px 20px 40px rgba(28, 27, 27, 0.03);
        }

        .table {
            border-collapse: separate;
            border-spacing: 0 4px;
        }

            .table th {
                border: none !important;
                font-family: var(--font-display);
                font-weight: 700;
                text-transform: uppercase;
                font-size: 0.75rem;
                letter-spacing: 0.75px;
                color: var(--text-main);
                opacity: 0.6;
                padding: 16px 24px !important;
            }

            .table td {
                border: none !important;
                padding: 18px 24px !important;
                font-family: var(--font-body);
                color: var(--text-main);
            }

            .table tbody tr {
                border-radius: 12px;
                transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
            }

                .table tbody tr:hover {
                    background-color: var(--surface-low) !important;
                }

        .member-avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: var(--font-display);
            font-weight: 700;
            font-size: 0.875rem;
            color: var(--primary);
            background-color: rgba(0, 74, 232, 0.1);
        }

        .btn-action {
            border: none;
            transition: all 0.2s ease;
        }

            .btn-action:hover {
                transform: scale(1.02);
            }
    </style>
}
<div class="container-fluid py-4">
    @* Header *@
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-5">
        <div>
            <h1 class="display-6 fw-extrabold text-main mb-1" style="font-family: var(--font-display); letter-spacing: -1.5px;">
                Members List
            </h1>
            <p class="text-muted mb-0">
                Manage gym members, subscription plans, and trainer assignments.
            </p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary rounded-pill text-white px-4 py-2.5 d-flex align-items-center gap-2 btn-action" style="background: var(--primary-gradient); font-weight: 600; font-family: var(--font-display);">
                <i class="bi bi-plus-lg"></i> Add New Member
            </a>
        </div>
    </div>

    @* Search Form *@
    <form asp-action="Index" method="get" class="mb-4">
        <div class="card bg-surface-lowest border-0 rounded-4 p-3 shadow-sm" style="box-shadow: 0px 20px 40px rgba(28, 27, 27, 0.03);">
            <div class="d-flex gap-2">
                <div class="position-relative flex-grow-1">
                    <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                    <input type="text" name="search" class="form-control border-0 bg-surface-low rounded-pill py-2.5 ps-5" placeholder="Search members by name or details..." style="font-family: var(--font-body);" />
                </div>
                <button type="submit" class="btn btn-primary rounded-pill px-4 text-white btn-action" style="background: var(--primary-gradient); font-family: var(--font-display); font-weight: 600;">Search</button>
            </div>
        </div>
    </form>

    @* Table Card *@
    <div class="card bg-surface-lowest border-0 rounded-4 p-4 members-table-card">
        <div class="table-responsive">
            <table class="table table-hover align-middle border-0 mb-0">
                <thead>
                    <tr>
                        <th style="min-width: 250px">Member Name</th>
                        <th>Phone</th>
                        <th>Trainer</th>
                        <th >Plan</th>
                        <th >Status</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var fallbackInitial = string.IsNullOrWhiteSpace(item.FullName)
                            ? "?"
                            : item.FullName.Trim().Substring(0, 1).ToUpper();
                        var photoUrl = string.IsNullOrWhiteSpace(item.PhotoPath)
                            ? null
                            : Url.Content(item.PhotoPath.StartsWith("~/", StringComparison.Ordinal)
                                ? item.PhotoPath
                                : $"~{item.PhotoPath}");

                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    @if (!string.IsNullOrWhiteSpace(photoUrl))
                                    {
                                        <img src="@photoUrl"
                                             alt="@item.FullName photo"
                                             class="rounded-3 border"
                                             style="width: 48px; height: 48px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <span class="rounded-3 bg-secondary text-white d-inline-flex align-items-center justify-content-center fw-bold"
                                              style="width: 48px; height: 48px;">
                                            @fallbackInitial
                                        </span>
                                    }
                                    <div class="overflow-hidden">
                                        <div class="fw-bold text-truncate" style="font-size: 0.95rem;">
                                            @item.FullName
                                        </div>
                                        <div class="text-muted fw-light text-truncate" style="font-size: 0.85rem;">
                                            @item.Email
                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td>@item.Phone</td>
                            <td>@(item.TrainerName ?? "Not Assigned")</td>
                            <td>
                                @if (item.ActivePlanName == "Premium")
                                {
                                    <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-2 fw-semibold">
                                         @item.ActivePlanName
                                    </span>
                                }
                                else if (item.ActivePlanName == "Day Pass")
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3 py-2 fw-semibold">
                                        @item.ActivePlanName
                                    </span>
                                }
                                else if (item.ActivePlanName == "Standard")
                                {
                                    <span class="badge bg-info bg-opacity-10 text-info rounded-pill px-3 py-2 fw-semibold">
                                        @item.ActivePlanName
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3 py-2 fw-semibold">
                                        Inactive
                                    </span>
                                }
                            </td>
                            <td>
                                @if (item.SubscriptionStatus == "Active")
                                {
                                    <span class=" badge bg-opacity-10 text-success px-3 py-2 fw-semibold">
                                        <i class="bi bi-check-circle-fill me-1"></i>Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge  bg-opacity-10 text-danger px-3 py-2 fw-semibold">
                                        <i class="bi bi-x-circle-fill me-1"></i>Inactive
                                    </span>
                                }
                            </td>
                            <td class="text-center">
                                @* Icon *@
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-outline-secondary rounded-circle border-0"
                                            type="button"
                                            data-bs-toggle="dropdown"
                                            aria-expanded="false"
                                            style="width: 32px; height: 32px; padding: 0;">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>

                                    @* Drop down menu *@
                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3" style="min-width: 180px;">
                                        <li>
                                            <a asp-action="Edit" asp-route-id="@item.Id"
                                               class="dropdown-item py-2">
                                                <i class="bi bi-pencil-fill me-2"></i> Edit
                                            </a>
                                        </li>
                                        <li>
                                            <a asp-controller="Subscriptions" asp-action="Assign" asp-route-memberId="@item.Id"
                                               class="dropdown-item py-2">
                                                <i class="bi bi-card-checklist me-2"></i> Subscription
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                                                  onsubmit="return confirm('Are you sure you want to delete this member?');">
                                                <button type="submit"
                                                        class="dropdown-item py-2 text-danger">
                                                    <i class="bi bi-trash-fill me-2"></i> Delete
                                                </button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
