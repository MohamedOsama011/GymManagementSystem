@using GymSystem.Models.DTOs;
@using GymSystem.Web.ViewModels.Members
@model IEnumerable<MemberListViewModel>

@{
    ViewData["Title"] = "Members List";
}

@section Styles {
    <style>
        .members-table-card {
            box-shadow: 0px 20px 40px rgba(28, 27, 27, 0.03);
        }
        .table {
            border-collapse: separate;
            border-spacing: 0 4px;
        }
        .table th {
            border: none !important;
            font-family: var(--font-display);
            font-weight: 700;
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 0.75px;
            color: var(--text-main);
            opacity: 0.6;
            padding: 16px 24px !important;
        }
        .table td {
            border: none !important;
            padding: 18px 24px !important;
            font-family: var(--font-body);
            color: var(--text-main);
        }
        .table tbody tr {
            border-radius: 12px;
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .table tbody tr:hover {
            background-color: var(--surface-low) !important;
        }
        .member-avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: var(--font-display);
            font-weight: 700;
            font-size: 0.875rem;
            color: var(--primary);
            background-color: rgba(0, 74, 232, 0.1);
        }
        .btn-action {
            border: none;
            transition: all 0.2s ease;
        }
        .btn-action:hover {
            transform: scale(1.02);
        }
    </style>
}

<div class="container-fluid py-4">
    @* Header *@
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-5">
        <div>
            <h1 class="display-6 fw-extrabold text-main mb-1" style="font-family: var(--font-display); letter-spacing: -1.5px;">
                Members List
            </h1>
            <p class="text-muted mb-0">
                Manage gym members, subscription plans, and trainer assignments.
            </p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary rounded-pill text-white px-4 py-2.5 d-flex align-items-center gap-2 btn-action" style="background: var(--primary-gradient); font-weight: 600; font-family: var(--font-display);">
                <i class="bi bi-plus-lg"></i> Add New Member
            </a>
        </div>
    </div>

    @* Search Form *@
    <form asp-action="Index" method="get" class="mb-4">
        <div class="card bg-surface-lowest border-0 rounded-4 p-3 shadow-sm" style="box-shadow: 0px 20px 40px rgba(28, 27, 27, 0.03);">
            <div class="d-flex gap-2">
                <div class="position-relative flex-grow-1">
                    <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                    <input type="text" name="search" class="form-control border-0 bg-surface-low rounded-pill py-2.5 ps-5" placeholder="Search members by name or details..." style="font-family: var(--font-body);" />
                </div>
                <button type="submit" class="btn btn-primary rounded-pill px-4 text-white btn-action" style="background: var(--primary-gradient); font-family: var(--font-display); font-weight: 600;">Search</button>
            </div>
        </div>
    </form>

    @* Table Card *@
    <div class="card bg-surface-lowest border-0 rounded-4 p-4 members-table-card">
        <div class="table-responsive">
            <table class="table table-hover align-middle border-0 mb-0">
                <thead>
                    <tr>
                        <th>Full Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Trainer</th>
                        <th>Plan</th>
                        <th>Status</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="member-avatar">
                                        @item.FullName?.Substring(0, 1).ToUpper()
                                    </div>
                                    <span class="text-main font-display">@item.FullName</span>
                                </div>
                            </td>
                            <td>@item.Email</td>
                            <td>@item.Phone</td>
                            <td>@(item.TrainerName ?? "Not Assigned")</td>
                            <td>@(item.ActivePlanName ?? "No Active Plan")</td>
                            <td>
                                @if (item.SubscriptionStatus == "Active")
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2 fw-semibold">
                                        <i class="bi bi-check-circle-fill me-1"></i>Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3 py-2 fw-semibold">
                                        <i class="bi bi-x-circle-fill me-1"></i>Inactive
                                    </span>
                                }
                            </td>
                            <td>
                                <div class="d-flex align-items-center justify-content-center gap-2">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm rounded-pill fw-semibold bg-surface-low text-main px-3 py-2 btn-action">
                                        <i class="bi bi-pencil-fill me-1"></i>Edit
                                    </a>
                                    <a asp-controller="Subscriptions" asp-action="Assign" asp-route-memberId="@item.Id" class="btn btn-sm rounded-pill fw-semibold bg-primary bg-opacity-10 text-primary px-3 py-2 btn-action">
                                        <i class="bi bi-card-checklist me-1"></i>Subscription
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('Are you sure you want to delete this member?');">
                                        <button type="submit" class="btn btn-sm rounded-pill fw-semibold bg-danger bg-opacity-10 text-danger px-3 py-2 border-0 btn-action">
                                            <i class="bi bi-trash-fill me-1"></i>Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
