@* 📁 Views/Classes/Create.cshtml *@
@model GymSystem.Web.ViewModels.Classes.GymClassFormViewModel

@{
    ViewData["Title"] = "Add New Class";
}

@section Styles {
    <style>
        .form-card {
            box-shadow: 0px 20px 40px rgba(28, 27, 27, 0.03);
            background-color: var(--surface-lowest);
        }
        
        .form-label {
            font-family: var(--font-display);
            font-weight: 600;
            font-size: 0.875rem;
            color: var(--text-main);
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            opacity: 0.8;
        }

        .kinetic-input, .kinetic-select {
            background-color: var(--surface-low) !important;
            border: 2px solid transparent !important;
            border-radius: 12px !important;
            padding: 12px 18px !important;
            color: var(--text-main) !important;
            font-family: var(--font-body);
            transition: all 0.2s ease !important;
            outline: none !important;
        }

        .kinetic-input:focus, .kinetic-select:focus {
            border-color: var(--primary) !important;
            background-color: var(--surface-lowest) !important;
            box-shadow: 0px 0px 0px 4px rgba(0, 74, 232, 0.15) !important;
        }

        .btn-action {
            border: none;
            transition: all 0.2s ease;
        }
        
        .btn-action:hover {
            transform: scale(1.02);
        }
    </style>
}

<div class="container-fluid py-4">
    @* Back Link *@
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none text-muted fw-semibold d-inline-flex align-items-center gap-2 btn-action">
            <i class="bi bi-arrow-left"></i> Back to Classes
        </a>
    </div>

    @* Header *@
    <div class="mb-5">
        <h1 class="display-6 fw-extrabold text-main mb-2" style="font-family: var(--font-display); letter-spacing: -1.5px;">
            Create New Class
        </h1>
        <p class="text-muted mb-0">
            Define a new gym class session, set its schedule, capacity, and assign a trainer.
        </p>
    </div>

    @* Form Container *@
    <div class="row">
        <div class="col-lg-8">
            <div class="card border-0 rounded-4 p-4 p-md-5 form-card">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

                    <div class="row g-4 mb-4">
                        <div class="col-md-12">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" class="form-control kinetic-input" placeholder="e.g. High-Intensity HIIT" />
                            <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>

                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <label asp-for="TrainerId" class="form-label"></label>
                            <select asp-for="TrainerId" asp-items="Model.Trainers" class="form-select kinetic-select">
                                <option value="">-- Select Trainer --</option>
                            </select>
                            <span asp-validation-for="TrainerId" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CategoryId" class="form-label"></label>
                            <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select kinetic-select">
                                <option value="">-- Select Category --</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>

                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <label asp-for="StartTime" class="form-label"></label>
                            <input asp-for="StartTime" type="datetime-local" class="form-control kinetic-input" />
                            <span asp-validation-for="StartTime" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="EndTime" class="form-label"></label>
                            <input asp-for="EndTime" type="datetime-local" class="form-control kinetic-input" />
                            <span asp-validation-for="EndTime" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>

                    <div class="mb-5">
                        <label asp-for="Capacity" class="form-label"></label>
                        <input asp-for="Capacity" type="number" min="1" max="200" class="form-control kinetic-input" />
                        <span asp-validation-for="Capacity" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="d-flex justify-content-end align-items-center gap-3">
                        <a asp-action="Index" class="btn btn-light rounded-pill px-4 py-2.5 btn-action fw-semibold" style="background-color: var(--surface-low); color: var(--text-main);">
                            Cancel
                        </a>
                        <button type="submit" class="btn btn-primary rounded-pill text-white px-5 py-2.5 btn-action" style="background: var(--primary-gradient); font-weight: 600; font-family: var(--font-display);">
                            Create Class
                        </button>
                    </div>
                </form>
            </div>
        </div>
        
        @* Sidebar Tip Column *@
        <div class="col-lg-4 mt-4 mt-lg-0">
            <div class="card border-0 rounded-4 p-4 bg-surface-low h-100 d-flex flex-column justify-content-between">
                <div>
                    <h5 class="fw-bold font-display text-main mb-3">Scheduling Tips</h5>
                    <ul class="list-unstyled d-flex flex-column gap-3 text-muted" style="font-size: 0.9rem;">
                        <li class="d-flex align-items-start gap-2">
                            <i class="bi bi-info-circle text-primary mt-1"></i>
                            <span>Ensure the End Time is strictly after the Start Time. Overlapping classes in the same studio might cause issues.</span>
                        </li>
                        <li class="d-flex align-items-start gap-2">
                            <i class="bi bi-info-circle text-primary mt-1"></i>
                            <span>Capacity defines how many members can enroll. Set this according to your studio's equipment availability.</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function() {
            // Validate that end time is after start time
            $('form').submit(function(e) {
                var startTime = new Date($('#StartTime').val());
                var endTime = new Date($('#EndTime').val());

                if (endTime <= startTime) {
                    e.preventDefault();
                    Swal.fire({
                        icon: 'error',
                        title: 'Invalid Time',
                        text: 'End time must be after start time'
                    });
                }
            });
        });
    </script>
}