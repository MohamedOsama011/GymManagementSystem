@* 📁 Views/Classes/Create.cshtml *@
@model GymSystem.Web.ViewModels.Classes.GymClassFormViewModel

@{
    ViewData["Title"] = "Add New Class";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-plus-circle me-2"></i>Add New Class
                    </h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <label asp-for="Name" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fas fa-tag"></i>
                                    </span>
                                    <input asp-for="Name" class="form-control"
                                           placeholder="Enter class name" />
                                </div>
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="TrainerId" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fas fa-user-tie"></i>
                                    </span>
                                    <select asp-for="TrainerId" asp-items="Model.Trainers"
                                            class="form-select">
                                        <option value="">-- Select Trainer --</option>
                                    </select>
                                </div>
                                <span asp-validation-for="TrainerId" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="CategoryId" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fas fa-list"></i>
                                    </span>
                                    <select asp-for="CategoryId" asp-items="Model.Categories"
                                            class="form-select">
                                        <option value="">-- Select Category --</option>
                                    </select>
                                </div>
                                <span asp-validation-for="CategoryId" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="StartTime" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fas fa-calendar"></i>
                                    </span>
                                    <input asp-for="StartTime" class="form-control"
                                           type="datetime-local" />
                                </div>
                                <span asp-validation-for="StartTime" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="EndTime" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fas fa-calendar-check"></i>
                                    </span>
                                    <input asp-for="EndTime" class="form-control"
                                           type="datetime-local" />
                                </div>
                                <span asp-validation-for="EndTime" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Capacity" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fas fa-users"></i>
                                    </span>
                                    <input asp-for="Capacity" class="form-control"
                                           type="number" min="1" max="200" />
                                </div>
                                <span asp-validation-for="Capacity" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-2"></i>Back to List
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save me-2"></i>Create Class
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function() {
            // Validate that end time is after start time
            $('form').submit(function(e) {
                var startTime = new Date($('#StartTime').val());
                var endTime = new Date($('#EndTime').val());

                if (endTime <= startTime) {
                    e.preventDefault();
                    Swal.fire({
                        icon: 'error',
                        title: 'Invalid Time',
                        text: 'End time must be after start time'
                    });
                }
            });
        });
    </script>
}